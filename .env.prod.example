# Producción (paso 7a). Copia este archivo como .env.prod y rellénalo.
# .env.prod nunca se sube a Git. En el servidor, protégelo: chmod 600 .env.prod
# Genera cada contraseña y secreto con: openssl rand -base64 36

# Dirección pública, sin https:// (p. ej. gestiondecitas.duckdns.org).
# Para probarlo en tu PC: localhost (el navegador avisará del certificado).
DOMINIO=localhost

# Versión de las imágenes publicadas en GitHub (sin la "v"): 1.0.0, 1.1.0...
# "local" = las que construyes en tu PC con --build.
VERSION=local

# Puertos del servidor. Cámbialos solo si 80 o 443 ya están ocupados en tu PC
# (entonces abre https://localhost:PUERTO_HTTPS).
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Base de datos (solo se ve dentro de Docker).
POSTGRES_DB=gestion_de_citas
POSTGRES_USER=gestion_de_citas
POSTGRES_PASSWORD=genera-una-contrasena-larga

# Clave para firmar los tokens de sesión: al menos 32 caracteres aleatorios.
JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres

# Primer administrador: se crea al arrancar si ese correo aún no existe.
# La contraseña necesita 10 caracteres o más y no puede ser muy común.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=genera-una-contrasena-larga
ADMIN_NOMBRE=Administrador

# Perfiles de Spring: prod siempre; demo crea los datos de demostración si aún no hay servicios.
PERFILES=prod,demo
# Contraseña de todas las cuentas de demostración (10 caracteres o más).
DEMO_PASSWORD=genera-una-contrasena-de-demo

# Correo (recuperar contraseña). El proveedor real (Brevo) se configura en el
# paso 7d. Mientras tanto, vacío: el envío falla y solo queda en el log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
