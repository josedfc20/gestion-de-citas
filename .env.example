# Copia este archivo como .env y rellena los valores. .env nunca se sube a Git.

# Base de datos (PostgreSQL en Docker)
POSTGRES_DB=gestion_de_citas
POSTGRES_USER=gestion_de_citas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Backend
DB_URL=jdbc:postgresql://localhost:5433/gestion_de_citas
# Clave para firmar los tokens de sesión: al menos 32 caracteres aleatorios.
# En la guía docs/guias/arrancar-backend.md está el comando para generarla.
JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true también en local: los navegadores aceptan cookies Secure en localhost.
COOKIE_SECURE=true

# Primer administrador: se crea al arrancar si ese correo aún no existe.
# La contraseña necesita 10 caracteres o más y no puede ser muy común.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador

# Correo (recuperar contraseña). En local, Mailpit de docker-compose:
# los correos no salen a Internet y se ven en http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@gestiondecitas.local
# Web a la que lleva el enlace del correo.
APP_WEB_URL=http://localhost:5173
