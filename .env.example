# Copia este archivo como .env y rellena los valores. .env nunca se sube a Git.

# Base de datos (PostgreSQL en Docker)
POSTGRES_DB=gestion_de_citas
POSTGRES_USER=gestion_de_citas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Backend
DB_URL=jdbc:postgresql://localhost:5433/gestion_de_citas
JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
CORS_ALLOWED_ORIGINS=http://localhost:5173
