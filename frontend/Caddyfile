# Caddy en producción (pasos 7a y 7b): HTTPS automático, la web, /api al backend
# y las cabeceras de seguridad. DOMINIO llega de .env.prod. Con "localhost" Caddy
# usa un certificado propio (el navegador avisa); con un dominio real lo pide a
# Let's Encrypt y lo renueva solo. Las pruebas: e2e/produccion/.

{$DOMINIO} {
	encode zstd gzip

	# Cabeceras de seguridad (7b), en todas las respuestas, también las de /api.
	header {
		# Solo HTTPS durante un año (RNF-004). Sin preload: no se puede con un
		# subdominio de DuckDNS y es muy difícil de deshacer.
		Strict-Transport-Security "max-age=31536000"
		# Solo se ejecuta y se carga lo que viene de esta dirección. La web no tiene
		# scripts ni estilos en línea (style={{...}}): csp.spec.ts falla si aparecen.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# No anunciar qué servidor hay. "defer": se aplica al final, también a
		# lo que añade el proxy (Via).
		-Server
		-Via
		defer
	}

	# La API: misma dirección que la web, así la cookie del refresh viaja sin CORS.
	# Caddy pone la IP real del usuario en X-Forwarded-For (la que mande el
	# navegador no se reenvía) y el backend la usa para el límite de intentos (D-9).
	# Sus respuestas conservan las cabeceras del backend (Cache-Control: no-store...).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# La web. Los archivos de /assets llevan una huella en el nombre
	# (index-BY1HMJhv.js): no cambian nunca, así que se guardan un año.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# El resto: si la ruta no es un archivo (/mis-citas, /admin/...), index.html y
	# React Router decide qué página enseñar. Sin caché, para que una versión
	# nueva se vea al momento.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
